{
  "name": "@heximal/site-content",
  "private": true,
  "version": "0.0.0",
  "description": "Heximal website content built with Eleventy",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "start": "wireit"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-navigation": "^1.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "open-props": "^1.7.14"
  },
  "wireit": {
    "build": {
      "command": "eleventy",
      "files": [
        ".eleventy.js",
        "site/**/*"
      ],
      "output": [
        "out"
      ]
    },
    "start": {
      "command": "eleventy --serve",
      "service": {
        "readyWhen": {
          "lineMatches": "[11ty] Server at"
        }
      },
      "files": [],
      "dependencies": [
        "build"
      ]
    }
  }
}
